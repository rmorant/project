<odoo>

    <record id="view_project_time_type_tree" model="ir.ui.view">
        <field name="model">project.time.type</field>
        <field name="inherit_id" ref="hr_timesheet_time_type.view_project_time_type_tree" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="sequence" widget="handle" optional="show"/>
            </field>
            <tree position="inside">
                <field name="user_ids" widget="many2many_tags" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_project_time_type_form" model="ir.ui.view">
        <field name="name">project.time.type.form.control</field>
        <field name="model">project.time.type</field>
        <field name="inherit_id" ref="hr_timesheet_time_type.view_project_time_type_form" />
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="sequence" groups="base.group_no_one"/>
            </field>
            <sheet position="inside">
                <group string="Filter by users">
                    <field name="user_ids" widget="many2many_tags" options="{'no_create': True}" nolabel="1" colspan="2" />
                </group>
            </sheet>
        </field>
    </record>

</odoo>
